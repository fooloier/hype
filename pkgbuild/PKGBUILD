pkgname=hype
pkgver=0.6.0
pkgrel=1
pkgdesc='Simple Markdown presentations with a visual slide editor'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base>=6.9' 'qt6-declarative>=6.9' 'qt6-multimedia>=6.9' 'qt6-imageformats' 'qt6-svg' 'ffmpeg' 'source-highlight' 'zlib' 'libwebp' 'xdg-desktop-portal' 'tinyxml2')
makedepends=('gcc' 'make' 'git')
_microtex_revision=0e3707f6dafebb121d98b53c64364d16fefe481d
source=("MicroTeX::git+https://github.com/NanoMichael/MicroTeX.git#commit=$_microtex_revision")
sha256sums=('SKIP')
build() {
  cd "$startdir/.."
  HYPE_MICROTEX_SOURCE="$srcdir/MicroTeX" ./bin/build
}
package() {
  cd "$startdir/.."
  install -Dm755 build/hype "$pkgdir/usr/bin/hype"
  install -Dm644 pkgbuild/hype.desktop "$pkgdir/usr/share/applications/hype.desktop"
  install -Dm644 pkgbuild/hype.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/hype.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/hype/LICENSE"
  install -d "$pkgdir/usr/share/hype/math"
  cp -a build/math-res/. "$pkgdir/usr/share/hype/math/"
}
